#!/command/with-contenv bashio

if bashio::config.true 'debug'; then
    bashio::log.info "Starting owserver with debug logging..."
    exec /opt/owfs/bin/owserver --foreground --debug -c /etc/owfs.conf
fi

bashio::log.info "Starting owserver..."
exec /opt/owfs/bin/owserver --foreground -c /etc/owfs.conf
