#!/command/with-contenv bashio

# Normalize USB device paths without changing the persisted user options.
if ! jq -f /etc/owfs-options.jq /data/options.json > /run/owserver-options.json; then
    bashio::exit.nok "Unable to normalize the OWFS device configuration"
fi

# generating owfs config file
tempio \
    -conf /run/owserver-options.json \
    -template /etc/owfs.template.conf \
    -out /etc/owfs.conf

owfs_generated_config=$(cat /etc/owfs.conf)
bashio::log.info "Generated owfs.config file:"
bashio::log.info "${owfs_generated_config}"
