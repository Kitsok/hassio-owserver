 	fprintf(out, "\r\n");
 }
 
+/* Resolve relative links from the OWHTTPD root, preserving any ingress prefix.
+ * Count URL separators, not decoded device names; trailing slashes matter. */
+static void HTTPbase(FILE *out, const char *path)
+{
+    const char *p = path;
+    fputs("<BASE HREF='./", out);
+    if (p != NULL && *p == '/') {
+        for (++p; *p != '\0' && *p != '?' && *p != '#'; ++p) {
+            if (*p == '/') {
+                fputs("../", out);
+            }
+        }
+    }
+    fputs("'>", out);
+}
+
 void HTTPtitle(struct OutputControl * oc, const char *title)
 {
 	FILE * out = oc->out ;
 	
-	fprintf(out, "<HTML><HEAD><TITLE>1-Wire Web: %s</TITLE></HEAD>\n", title);
+	fputs("<HTML><HEAD>", out);
+	HTTPbase(out, oc->request_path);
+	fprintf(out, "<TITLE>1-Wire Web: %s</TITLE></HEAD>\n", title);
 }
 
 void HTTPheader(struct OutputControl * oc, const char *head)
@@ -62,7 +80,7 @@ void HTTPheader(struct OutputControl * oc, const char *head)
 	
